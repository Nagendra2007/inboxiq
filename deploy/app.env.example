# Copy to /opt/mailroom/app.env on the instance and fill in. Never commit the
# filled-in copy. `chmod 600` it — it holds the keys to a Gmail mailbox.

# --- Database: RDS, private, same VPC and region as this instance. sslmode=require
# encrypts the connection without needing the RDS CA bundle in a truststore;
# verify-full is the hardening step once you are happy it works.
#
# The stored Gmail tokens are encrypted with TOKEN_ENCRYPTION_KEY below, so
# if you migrate rows from the old database, that key must come with them.
DATABASE_URL=jdbc:postgresql://<rds-endpoint>.ap-south-1.rds.amazonaws.com:5432/mailroom?sslmode=require
DATABASE_USERNAME=mailroom
DATABASE_PASSWORD=

# --- Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The three settings that used to come free from RENDER_EXTERNAL_URL.
# On EC2 nothing injects them, and unset they silently fall back to
# http://localhost:5173, which fails as a Google redirect_uri_mismatch.
FRONTEND_URL=https://mail.example.com
CORS_ALLOWED_ORIGINS=https://mail.example.com
GOOGLE_REDIRECT_URI=https://mail.example.com/login/oauth2/code/google

# --- Cookies: behind Caddy this is https, so both of these matter.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# --- AES-256-GCM key for Gmail tokens at rest. Carry the EXISTING value
# across from Render. A new key makes every stored token undecryptable and
# forces every user to reconnect Gmail.
TOKEN_ENCRYPTION_KEY=

# --- AI
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# --- Optional: pin the admin account (else the first to sign in becomes it)
ADMIN_EMAILS=
