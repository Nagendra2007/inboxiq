# Leave empty. In development Vite proxies /api to the backend, and in
# production the backend serves this app from the same origin — either way
# the browser talks to the API same-origin. Only set this if the API lives on
# a different origin (not recommended: see DEPLOYMENT.md on cookies).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api, /oauth2 and /login/oauth2 to.
VITE_BACKEND_ORIGIN=http://localhost:8080
