# Copy this file to .env and fill in real values. Never commit .env.
#
# docker-compose.yml (see project root) reads this file automatically via
# `env_file: .env`. For running the backend directly with `mvn spring-boot:run`
# instead, export these into your shell environment first (see README
# "Running without Docker").

# --- Google OAuth 2.0 / Gmail API ---
# Create these at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). Enable the Gmail API on the same
# project. Add the redirect URI below as an "Authorized redirect URI".
# See README "Google Cloud setup" for the full walkthrough, including the
# OAuth consent screen "Testing" mode caveat (only test users you add can
# sign in until the app is verified by Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev (Vite on :5173, backend on :8080): the default below.
# Production: https://<your-domain>/login/oauth2/code/google
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- Database ---
# `docker compose up -d db` publishes Postgres on localhost:5433 (not 5432, so
# it can't collide with a PostgreSQL installed directly on your machine).
# Using your own local PostgreSQL instead? Point this at it (usually :5432).
# Ignored inside Docker Compose, where the app always uses db:5432.
DATABASE_URL=jdbc:postgresql://localhost:5433/inboxiq
DATABASE_USERNAME=inboxiq
DATABASE_PASSWORD=inboxiq

# --- Token encryption ---
# AES-256-GCM key used to encrypt OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
# or, in Windows PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Changing this after tokens have been stored makes existing tokens
# undecryptable (users would need to reconnect Gmail).
TOKEN_ENCRYPTION_KEY=

# --- AI provider (defaults) ---
# The admin can switch provider, model and key at any time in the app
# (Settings -> AI provider) without a redeploy; these apply until then.
# Provider: openrouter | openai | gemini | anthropic | groq | deepseek | mistral | custom
AI_PROVIDER=openrouter
# Key for that provider (e.g. https://openrouter.ai/keys). The older name
# OPENROUTER_API_KEY is still accepted.
AI_API_KEY=
# Any model the provider offers, e.g. openai/gpt-4o-mini on OpenRouter,
# gpt-4o-mini on OpenAI, gemini-2.5-flash on Gemini.
AI_MODEL=openai/gpt-4o-mini
# Only for AI_PROVIDER=custom (any OpenAI-compatible endpoint); presets
# know their own URL.
AI_BASE_URL=

# --- Administrator ---
# Google account(s) allowed to change the AI provider in the app,
# comma-separated. Leave empty and the first account to sign in is the admin.
ADMIN_EMAILS=

# --- Public URL of the app ---
# Where the browser lands after Google sign-in, and the origin allowed to
# call the API. Local dev with Vite: http://localhost:5173.
# Production (single image serves UI + API): your public URL, e.g.
# https://inboxiq.onrender.com — no trailing slash.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Cookies (session + CSRF) ---
# Lax is right for local dev and for the single-origin production image.
# In production (https) set COOKIE_SECURE=true.
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false

# --- Server ---
# Hosting platforms that inject PORT (Render, Railway, Fly, Heroku) take
# precedence over this.
SERVER_PORT=8080
